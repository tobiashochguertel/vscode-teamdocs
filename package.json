{
  "name": "teamdocs",
  "displayName": "TeamDocs",
  "description": "Your team's Markdown documentation, one click away in the Activity Bar \u2014 searchable from any project, no context switching.",
  "version": "0.4.1",
  "publisher": "TobiasHochguertel",
  "homepage": "https://github.com/tobiashochguertel/vscode-teamdocs/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobiashochguertel/vscode-teamdocs"
  },
  "bugs": {
    "url": "https://github.com/tobiashochguertel/vscode-teamdocs/issues",
    "email": "tobias.hochguertel@googlemail.com"
  },
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "teamDocs.openSettings",
        "title": "Team Docs: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "teamDocs.search",
        "title": "Team Docs: Search",
        "icon": "$(search)"
      },
      {
        "command": "teamDocs.review.rate",
        "title": "Team Docs: Leave a Review"
      },
      {
        "command": "teamDocs.copyPath",
        "title": "Copy Path",
        "category": "Team Docs"
      },
      {
        "command": "teamDocs.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Team Docs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "teamDocs.search",
          "when": "view == teamdocs",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "teamDocs.copyPath",
          "when": "view == teamdocs && viewItem =~ /file|folder/",
          "group": "9_copypath@1"
        },
        {
          "command": "teamDocs.copyRelativePath",
          "when": "view == teamdocs && viewItem =~ /file|folder/",
          "group": "9_copypath@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "teamdocs-explorer",
          "title": "Team Docs",
          "icon": "media/teamdocs-dark.svg"
        }
      ]
    },
    "views": {
      "teamdocs-explorer": [
        {
          "id": "teamdocs",
          "name": "",
          "icon": "media/teamdocs-dark.svg",
          "contextualTitle": "Team Docs Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "teamdocs",
        "contents": "Choose your documentation directory.\n[Add path to docs](command:teamDocs.openSettings)"
      }
    ],
    "configuration": [
      {
        "title": "Team Docs",
        "properties": {
          "teamdocs.path_to_docs_folder": {
            "type": "string",
            "markdownDescription": "Set the path to your documentation folder. Ex: ``~/Docs/engineering``",
            "default": ""
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "compile:test": "esbuild test/suite/*.test.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --outdir=out/test/suite",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run typecheck && npm run lint && npm run compile:test",
    "test": "vscode-test",
    "test:unit": "esbuild test/unit/copypath.test.ts --bundle --platform=node --format=cjs --outfile=out-test/unit/copypath.test.cjs && node --test out-test/unit/*.test.cjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.3"
  }
}
